{% set d = 'googleshoppingxml.bo.default' %}
{% set tab = app.request.query.get('current_tab') ?: 'feeds' %}
{% set config_url = path('admin.module.configure', {module_code: 'GoogleShoppingXml'}) %}

<div class="modules-configure">

    <ul id="tabbed-menu" class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link {{ tab == 'feeds' ? 'active' }}" data-bs-toggle="tab" data-bs-target="#feeds" type="button">{{ 'Feeds'|trans }}</button></li>
        <li class="nav-item"><button class="nav-link {{ tab == 'taxonomy' ? 'active' }}" data-bs-toggle="tab" data-bs-target="#taxonomy" type="button">{{ 'Google taxonomy'|trans }}</button></li>
        <li class="nav-item"><button class="nav-link {{ tab == 'advanced' ? 'active' }}" data-bs-toggle="tab" data-bs-target="#advanced" type="button">{{ 'Advanced configuration'|trans }}</button></li>
        <li class="nav-item"><button class="nav-link js_tab_gsxml_log {{ tab == 'log' ? 'active' }}" data-bs-toggle="tab" data-bs-target="#log" type="button">{{ 'Error log'|trans }}</button></li>
    </ul>

    <div class="tab-content">
        {# ============ FEEDS TAB ============ #}
        <div id="feeds" class="tab-pane {{ tab == 'feeds' ? 'active show' }}">
            <div class="card mb-3">
                <div class="card-header">{{ 'Google feeds configuration'|trans }}</div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <p>- {{ 'To upload your products in Google Shopping, you must first create a Google Merchant Account at %link.'|trans({'%link': '<a href="https://merchants.google.com/">https://merchants.google.com/</a>'}, d)|raw }}</p>
                        <p>- {{ 'Within the Google Merchant Center, you have to create "feeds" for each language, currency and country that you target.'|trans({}, d) }}</p>
                        <p>- {{ 'Once your feeds are set up in Google Merchant, re-create your feeds below with the same informations.'|trans({}, d) }}</p>
                        <p>-
                            {{ 'Finally, you will provide your product list to Google for each feed through a XML file.'|trans({}, d) }}
                            {{ 'For that, you can set up a automated fetch in Google Merchant Center by providing the link to the XML file (click on %icon to copy the link address) or upload the file manually.'|trans({'%icon': '<i class="bi bi-link-45deg"></i>'}, d)|raw }}
                        </p>
                    </div>

                    <div class="card card-body bg-light mb-3">
                        <form method="post" action="{{ path('googleshoppingxml.feed.add') }}" class="row g-2 align-items-end">
                            <input type="hidden" name="{{ feed_form.vars.full_name }}[_token]" value="{{ feed_form._token.vars.value }}">
                            <div class="col-md-2">
                                <label class="form-label" for="add_feed_label">{{ 'Feed label'|trans({}, d) }}</label>
                                <input id="add_feed_label" class="form-control" name="{{ feed_form.vars.full_name }}[feed_label]" required>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="add_lang_id">{{ 'Lang'|trans({}, d) }}</label>
                                <select id="add_lang_id" class="form-select" name="{{ feed_form.vars.full_name }}[lang_id]">
                                    {% for lang in langs %}<option value="{{ lang.id }}">{{ lang.title }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="add_currency_id">{{ 'Currency'|trans({}, d) }}</label>
                                <select id="add_currency_id" class="form-select" name="{{ feed_form.vars.full_name }}[currency_id]">
                                    {% for currency in currencies %}<option value="{{ currency.id }}">{{ currency.symbol }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="add_country_id">{{ 'Country'|trans({}, d) }}</label>
                                <select id="add_country_id" class="form-select" name="{{ feed_form.vars.full_name }}[country_id]">
                                    {% for country in countries %}<option value="{{ country.id }}" {{ country.id == 64 ? 'selected' }}>{{ country.title }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg"></i> {{ 'Add'|trans }}</button>
                            </div>
                        </form>
                    </div>

                    {% for feed in feeds %}
                    <div class="row g-2 align-items-center mb-2">
                        <form method="post" action="{{ path('googleshoppingxml.feed.update') }}" class="col-md-9 row g-2 align-items-center">
                            <input type="hidden" name="{{ feed_form.vars.full_name }}[_token]" value="{{ feed_form._token.vars.value }}">
                            <input type="hidden" name="{{ feed_form.vars.full_name }}[id]" value="{{ feed.id }}">
                            <div class="col-md-3"><input class="form-control" name="{{ feed_form.vars.full_name }}[feed_label]" value="{{ feed.label }}" required></div>
                            <div class="col-md-3">
                                <select class="form-select" name="{{ feed_form.vars.full_name }}[lang_id]">
                                    {% for lang in langs %}<option value="{{ lang.id }}" {{ lang.id == feed.lang_id ? 'selected' }}>{{ lang.title }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" name="{{ feed_form.vars.full_name }}[currency_id]">
                                    {% for currency in currencies %}<option value="{{ currency.id }}" {{ currency.id == feed.currency_id ? 'selected' }}>{{ currency.symbol }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" name="{{ feed_form.vars.full_name }}[country_id]">
                                    {% for country in countries %}<option value="{{ country.id }}" {{ country.id == feed.country_id ? 'selected' }}>{{ country.title }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-1"><button class="btn btn-success" type="submit"><i class="bi bi-check-lg"></i></button></div>
                        </form>
                        <div class="col-md-3">
                            <div class="btn-group">
                                <a class="btn btn-primary" href="{{ path('googleshoppingxml.generatefeedxml', {feedId: feed.id}) }}">{{ 'Generate'|trans }}</a>
                                <a class="js_download_xml_feed btn btn-info" title="{{ 'Download XML'|trans }}" href="{{ path('googleshoppingxml.getfeedxml', {feedId: feed.id}) }}" data-feedid="{{ feed.id }}" download>{{ 'XML'|trans }}</a>
                                <a href="#" class="js_btn_clipboard btn btn-secondary" title="{{ 'Copy XML link into clipboard'|trans }}" data-clipboardtext="{{ path('googleshoppingxml.getfeedxml', {feedId: feed.id}) }}"><i class="bi bi-link-45deg"></i></a>
                            </div>
                            <a href="#" class="js_btn_configure_custom_xml btn btn-primary ms-1" title="{{ 'Configure custom XML'|trans }}" data-feedid="{{ feed.id }}"><i class="bi bi-wrench"></i></a>
                            <form id="js_form_delete_feed_{{ feed.id }}" class="d-inline-block" method="post" action="{{ path('googleshoppingxml.feed.delete') }}">
                                <input type="hidden" name="id_feed_to_delete" value="{{ feed.id }}">
                                <a class="btn btn-danger js_btn_delete_with_warning" data-formid="js_form_delete_feed_{{ feed.id }}"><i class="bi bi-trash"></i></a>
                            </form>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# ============ TAXONOMY TAB ============ #}
        <div id="taxonomy" class="tab-pane {{ tab == 'taxonomy' ? 'active show' }}">
            <div class="card mb-3">
                <div class="card-header">{{ 'Google taxonomy management : associate Thelia categories with Google categories'|trans }}</div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <p>- {{ "Google has its own set of product categories. This tab allows you associate your own categories with Google's ones."|trans({}, d) }}</p>
                        <p>- {{ 'For some categories, the "google_product_category" attribute is mandatory in the XML output file provided to Google.'|trans({}, d) }}</p>
                        <p>-
                            {{ "If you did not specified a Google category for a Thelia category, it will search through its parent's category until it founds an association."|trans({}, d) }}
                            {{ 'However, we recommand that you associate a Google category for every category of your catalog.'|trans({}, d) }}
                            {{ 'The more specific your category association will be, the more likely your product will appear in Google Shopping results.'|trans({}, d) }}
                        </p>
                        <p>- {{ 'More information about the Google product categories at %link.'|trans({'%link': '<a href="https://support.google.com/merchants/answer/6324436">https://support.google.com/merchants/answer/6324436</a>'}, d)|raw }}</p>
                    </div>

                    <div class="card card-body bg-light mb-3">
                        <form action="{{ path('googleshoppingxml.taxonomy.associate') }}" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="{{ taxonomy_form.vars.full_name }}[_token]" value="{{ taxonomy_form._token.vars.value }}">
                            <div class="col-md-3">
                                <label class="form-label" for="thelia-category">{{ 'Thelia category'|trans }}</label>
                                <select id="thelia-category" class="form-select" name="{{ taxonomy_form.vars.full_name }}[thelia_category_id]">
                                    {% for cat in category_tree %}
                                        <option value="{{ cat.id }}">{% if cat.level > 0 %}{% for i in 1..cat.level %}&nbsp;&nbsp;&nbsp;&nbsp;{% endfor %}{% endif %}{{ cat.title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="search-taxonomy">{{ 'Search category'|trans }}</label>
                                <div class="input-group">
                                    <input class="form-control" type="text" id="search-taxonomy">
                                    <span class="input-group-text"><i class="bi bi-arrow-right"></i></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="google-taxonomy">{{ 'Google Category'|trans }}</label>
                                <select class="form-select" name="{{ taxonomy_form.vars.full_name }}[google_category_id]" id="google-taxonomy"></select>
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> {{ 'Associate'|trans }}</button>
                            </div>
                        </form>
                    </div>

                    {% if associated_categories|length %}
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{{ 'Thelia category Id'|trans }}</th>
                                <th>{{ 'Thelia category Title'|trans }}</th>
                                <th>{{ 'Associated Google category'|trans }}</th>
                                <th class="text-center">{{ 'Action'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for cat in associated_categories %}
                            <tr id="tr_category_{{ cat.id }}">
                                <td>{{ cat.id }}</td>
                                <td>{{ cat.title }}</td>
                                <td>{{ cat.google_category }}</td>
                                <td class="text-end">
                                    <form class="d-inline-block" action="{{ path('googleshoppingxml.taxonomy.delete') }}" method="post">
                                        <input type="hidden" name="category_id" value="{{ cat.id }}">
                                        <button class="btn btn-danger" type="submit" title="{{ 'Delete association'|trans }}"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <div class="alert alert-warning" role="alert">{{ 'No associated category'|trans }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ============ ADVANCED TAB ============ #}
        <div id="advanced" class="tab-pane {{ tab == 'advanced' ? 'active show' }}">
            <div class="card mb-3">
                <div class="card-header">{{ 'Advanced Google product fields configuration'|trans }}</div>
                <div class="card-body">
                    <div class="alert alert-info">
                        {{ 'In this tab, you can configure Google XML fields that are not filled by this module.'|trans }}
                        {{ 'If your store sells clothes, you must configure the following fields as they are marked "mandatory" by Google :'|trans }}
                        "<strong>age_group</strong>", "<strong>color</strong>", "<strong>gender</strong>", "<strong>size</strong>", "<strong>size_system</strong>".
                        {{ 'More information about Google fields specifications at %link.'|trans({'%link': '<a href="https://support.google.com/merchants/answer/7052112">https://support.google.com/merchants/answer/7052112</a>'}, d)|raw }}
                    </div>

                    <div class="card card-body bg-light mb-3">
                        <form method="post" action="{{ path('googleshoppingxml.advanced.field.add') }}" class="row g-2 align-items-start">
                            <div class="col-md-3">
                                <label class="form-label" for="advanced_input_google_attribute_new">{{ 'Google attribute'|trans }}</label>
                                <input id="advanced_input_google_attribute_new" class="form-control" name="google_attribute" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="advanced_select_type_new">{{ 'Association type'|trans }}</label>
                                <select id="advanced_select_type_new" class="js_advanced_select_association_type form-select" name="association_type" data-googlefieldid="new">
                                    <option value="0">-- {{ 'Select an association type'|trans }} --</option>
                                    <option value="1">{{ 'Fixed value'|trans }}</option>
                                    <option value="2">{{ 'Linked to a Thelia attribute'|trans }}</option>
                                    <option value="3">{{ 'Linked to a Thelia feature'|trans }}</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <div class="js_field_related_to_association_type" data-googlefieldid="new" data-associationtype="1">
                                    <label class="form-label" for="advanced_input_fixed_value_new">{{ 'Fixed value'|trans }}</label>
                                    <input id="advanced_input_fixed_value_new" class="form-control" name="fixed_value">
                                </div>
                                <div class="js_field_related_to_association_type" data-googlefieldid="new" data-associationtype="2">
                                    <label class="form-label" for="advanced_select_thelia_attribute_new">{{ 'Related Thelia attribute'|trans }}</label>
                                    <select id="advanced_select_thelia_attribute_new" class="form-select" name="thelia_attribute">
                                        <option value="0">-- {{ 'Select an attribute'|trans }} --</option>
                                        {% for attribute in attributes %}<option value="{{ attribute.id }}">{{ attribute.title }}</option>{% endfor %}
                                    </select>
                                </div>
                                <div class="js_field_related_to_association_type" data-googlefieldid="new" data-associationtype="3">
                                    <label class="form-label" for="advanced_select_thelia_feature_new">{{ 'Related Thelia feature'|trans }}</label>
                                    <select id="advanced_select_thelia_feature_new" class="form-select" name="thelia_feature">
                                        <option value="0">-- {{ 'Select a feature'|trans }} --</option>
                                        {% for feature in features %}<option value="{{ feature.id }}">{{ feature.title }}</option>{% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">&nbsp;</label>
                                <button class="btn btn-primary form-control" type="submit"><i class="bi bi-plus-lg"></i> {{ 'Add'|trans }}</button>
                            </div>
                        </form>
                    </div>

                    {% for fa in field_association_array %}
                    <div class="row g-2 align-items-start mb-2">
                        <form method="post" action="{{ path('googleshoppingxml.advanced.field.update') }}" class="col-md-11 row g-2 align-items-start">
                            <input type="hidden" value="{{ fa.Id }}" name="id">
                            <div class="col-md-3"><input class="form-control" name="google_attribute" value="{{ fa.GoogleField }}" required></div>
                            <div class="col-md-3">
                                <select class="js_advanced_select_association_type form-select" name="association_type" data-googlefieldid="{{ fa.Id }}">
                                    <option value="0">-- {{ 'Select an association type'|trans }} --</option>
                                    <option value="1" {{ fa.AssociationType == 1 ? 'selected' }}>{{ 'Fixed value'|trans }}</option>
                                    <option value="2" {{ fa.AssociationType == 2 ? 'selected' }}>{{ 'Linked to a Thelia attribute'|trans }}</option>
                                    <option value="3" {{ fa.AssociationType == 3 ? 'selected' }}>{{ 'Linked to a Thelia feature'|trans }}</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <div class="js_field_related_to_association_type" data-googlefieldid="{{ fa.Id }}" data-associationtype="1">
                                    <input class="form-control" name="fixed_value" value="{{ fa.FixedValue }}">
                                </div>
                                <div class="js_field_related_to_association_type" data-googlefieldid="{{ fa.Id }}" data-associationtype="2">
                                    <select class="form-select" name="thelia_attribute">
                                        <option value="0">-- {{ 'Select an attribute'|trans }} --</option>
                                        {% for attribute in attributes %}<option value="{{ attribute.id }}" {{ attribute.id == fa.IdRelatedAttribute ? 'selected' }}>{{ attribute.title }}</option>{% endfor %}
                                    </select>
                                </div>
                                <div class="js_field_related_to_association_type" data-googlefieldid="{{ fa.Id }}" data-associationtype="3">
                                    <select class="form-select" name="thelia_feature">
                                        <option value="0">-- {{ 'Select a feature'|trans }} --</option>
                                        {% for feature in features %}<option value="{{ feature.id }}" {{ feature.id == fa.IdRelatedFeature ? 'selected' }}>{{ feature.title }}</option>{% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2"><button class="btn btn-success form-control" type="submit"><i class="bi bi-check-lg"></i> {{ 'Save'|trans }}</button></div>
                        </form>
                        <div class="col-md-1">
                            <form method="post" action="{{ path('googleshoppingxml.advanced.field.delete') }}">
                                <input type="hidden" value="{{ fa.Id }}" name="id_field_to_delete">
                                <button class="btn btn-danger form-control" type="submit" title="{{ 'Remove'|trans }}"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header">
                            {{ 'Field "gtin" configuration'|trans }}
                            <a href="https://support.google.com/merchants/answer/6324461?hl=fr&ref_topic=6324338"><i class="bi bi-question-circle"></i></a>
                        </div>
                        <div class="card-body">
                            <small>{{ "Which product's EAN code should be included in the XML field \"gtin\" ?"|trans }}</small>
                            <form action="{{ path('googleshoppingxml.advanced.seteanrule') }}" method="post">
                                <div class="form-check"><input class="form-check-input" type="radio" id="gtin_all" name="gtin_rule" value="all" {{ ean_rule == 'all' ? 'checked' }}><label class="form-check-label" for="gtin_all">{{ 'Include all EAN codes without verification, ignore empty'|trans }}</label></div>
                                <div class="form-check"><input class="form-check-input" type="radio" id="gtin_flex" name="gtin_rule" value="check_flexible" {{ ean_rule == 'check_flexible' ? 'checked' }}><label class="form-check-label" for="gtin_flex">{{ 'Include only valid EAN codes, ignore invalid or empty'|trans }}</label></div>
                                <div class="form-check"><input class="form-check-input" type="radio" id="gtin_strict" name="gtin_rule" value="check_strict" {{ ean_rule == 'check_strict' ? 'checked' }}><label class="form-check-label" for="gtin_strict">{{ 'Include only valid EAN codes, launch error when invalid, ignore empty'|trans }}</label></div>
                                <div class="form-check mb-3"><input class="form-check-input" type="radio" id="gtin_none" name="gtin_rule" value="none" {{ ean_rule == 'none' ? 'checked' }}><label class="form-check-label" for="gtin_none">{{ 'Do not include any EAN code'|trans }}</label></div>
                                <button class="btn btn-success form-control" type="submit"><i class="bi bi-check-lg"></i> {{ 'Save'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header">{{ 'Compatibility SQL'|trans }}</div>
                        <div class="card-body">
                            <form action="{{ path('googleshoppingxml.advanced.compatibility-sql') }}" method="post">
                                <input type="hidden" name="{{ compatibility_sql_form.vars.full_name }}[_token]" value="{{ compatibility_sql_form._token.vars.value }}">
                                <input type="hidden" name="success_url" value="{{ config_url }}">
                                <div class="form-check form-switch">
                                    {{ form_widget(compatibility_sql_form.enable_optimisation, {attr: {class: 'form-check-input'}}) }}
                                    {{ form_label(compatibility_sql_form.enable_optimisation, null, {label_attr: {class: 'form-check-label'}}) }}
                                </div>
                                <button class="btn btn-success form-control mt-2" type="submit"><i class="bi bi-check-lg"></i> {{ 'Save'|trans }}</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ============ LOG TAB ============ #}
        <div id="log" class="tab-pane {{ tab == 'log' ? 'active show' }}">
            <div class="card">
                <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <a href="#" class="js_btn_gsxml_log_refresh btn btn-info"><i class="bi bi-arrow-clockwise"></i> {{ 'Refresh log'|trans }}</a>
                    <span class="gsxml_checkbox_container">
                        <label class="me-2"><input type="checkbox" class="js_checkbox_level_log" data-level="1" checked> {{ 'INFO'|trans }}</label>
                        <label class="me-2 gsxml_checkbox_success"><input type="checkbox" class="js_checkbox_level_log" data-level="2" checked> {{ 'SUCCESS'|trans }}</label>
                        <label class="me-2 gsxml_checkbox_warning"><input type="checkbox" class="js_checkbox_level_log" data-level="3" checked> {{ 'WARNING'|trans }}</label>
                        <label class="me-2 gsxml_checkbox_error"><input type="checkbox" class="js_checkbox_level_log" data-level="4" checked> {{ 'ERROR'|trans }}</label>
                        <label class="me-2 gsxml_checkbox_fatal"><input type="checkbox" class="js_checkbox_level_log" data-level="5" checked> {{ 'FATAL'|trans }}</label>
                    </span>
                    <div class="ms-auto">
                        <select class="form-select form-select-sm" id="js_select_log_limit" style="width:auto">
                            <option value="20">20</option>
                            <option value="50" selected>50</option>
                            <option value="100">100</option>
                            <option value="200">200</option>
                        </select>
                    </div>
                </div>
                <div class="card-body gsxml_panel_table_log_container">
                    <div class="text-center mb-2 gsxml_log_pager">
                        <a href="#" class="btn btn-secondary js_log_first_page"><i class="bi bi-skip-backward-fill"></i></a>
                        <a href="#" class="btn btn-secondary js_log_previous_page"><i class="bi bi-chevron-left"></i></a>
                        <a href="#" class="btn btn-secondary js_log_next_page"><i class="bi bi-chevron-right"></i></a>
                    </div>
                    <table id="js_table_xml_log" class="table">
                        <tr><td colspan="5">{{ 'Please click on the refresh button.'|trans }}</td></tr>
                    </table>
                    <div class="text-center mt-2 gsxml_log_pager">
                        <a href="#" class="btn btn-secondary js_log_first_page"><i class="bi bi-skip-backward-fill"></i></a>
                        <a href="#" class="btn btn-secondary js_log_previous_page"><i class="bi bi-chevron-left"></i></a>
                        <a href="#" class="btn btn-secondary js_log_next_page"><i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ===== Delete confirmation modal ===== #}
<div class="modal fade" id="js_modal_confirm_delete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Delete confirmation'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="js_body_modal_confirm_delete" class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> {{ 'No'|trans }}</button>
                <button type="button" id="js_btn_modal_confirm_delete_confirm" class="btn btn-primary"><i class="bi bi-check-lg"></i> {{ 'Yes'|trans }}</button>
            </div>
        </div>
    </div>
</div>

{# ===== Custom XML modal ===== #}
<div class="modal fade" id="js_modal_custom_xml" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Custom XML generation'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    {{ 'The default XML file generated currently contains %count product items (all your catalog).'|trans({'%count': pse_count}, d) }}
                    {{ 'If you have too many products and have difficulties to generate the big XML file, you can generate multiple smaller XML files below.'|trans({}, d) }}
                    {{ 'However, the automated Google fetch schedule allows only one file per feed.'|trans({}, d) }}
                    {{ 'If you choose the custom XML files generation, you will have to upload them manually in Google Merchant Center.'|trans({}, d) }}
                </div>
                <div class="mb-3">
                    <label class="form-label" for="js_input_xml_divide_time">{{ 'Divide your catalog into X parts'|trans }} : </label>
                    <input class="form-control" id="js_input_xml_divide_time" type="number">
                </div>
                <a id="js_btn_generate_custom_xml" href="#" class="btn btn-primary">{{ 'Generate custom XML links'|trans }}</a>
                <div id="js_xml_divided_link_container" class="card card-body mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> {{ 'Close'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    "use strict";
    const PSE_COUNT = {{ pse_count }};
    const LOG_URL = "{{ path('googleshoppingxml.log.get') }}";
    const TAXONOMY_URL = "{{ path('googleshoppingxml.taxonomy.get', {langId: current_lang_id}) }}";
    const PRODUCT_UPDATE_URL = "{{ path('admin.products.update') }}";
    const L = {
        copied: {{ 'Copied!'|trans|json_encode|raw }},
        deleteFeedLine1: {{ 'Do you really want to delete this feed ?'|trans|json_encode|raw }},
        deleteFeedLine2: {{ "Please note that it won't delete the feed in your Google Merchant account. You will have to do it manually in the Google Merchant Center page."|trans|json_encode|raw }},
        ajaxError: {{ 'An error has occurred during the server request.'|trans|json_encode|raw }},
        nothing: {{ 'Nothing to show.'|trans|json_encode|raw }},
        date: {{ 'Date'|trans|json_encode|raw }},
        feed: {{ 'Feed'|trans|json_encode|raw }},
        level: {{ 'Level'|trans|json_encode|raw }},
        message: {{ 'Message'|trans|json_encode|raw }},
        productItem: {{ 'Product item'|trans|json_encode|raw }}
    };
    const LEVELS = {
        1: {className: '', label: {{ 'INFO'|trans|json_encode|raw }}, name: 'info'},
        2: {className: 'tr_log_success', label: {{ 'SUCCESS'|trans|json_encode|raw }}, name: 'success'},
        3: {className: 'tr_log_warning', label: {{ 'WARNING'|trans|json_encode|raw }}, name: 'warning'},
        4: {className: 'tr_log_error', label: {{ 'ERROR'|trans|json_encode|raw }}, name: 'error'},
        5: {className: 'tr_log_fatal', label: {{ 'FATAL'|trans|json_encode|raw }}, name: 'fatal'}
    };

    document.addEventListener('DOMContentLoaded', function () {

        // ===== Clipboard =====
        document.querySelectorAll('.js_btn_clipboard').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const text = btn.dataset.clipboardtext;
                navigator.clipboard.writeText(text).catch(function () {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); } catch (err) {}
                    document.body.removeChild(ta);
                });
            });
        });

        // ===== Delete feed confirm =====
        const deleteModalEl = document.getElementById('js_modal_confirm_delete');
        const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
        const confirmBtn = document.getElementById('js_btn_modal_confirm_delete_confirm');
        confirmBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const formid = this.dataset.formid;
            this.dataset.formid = '';
            if (formid) {
                const f = document.getElementById(formid);
                if (f) { f.submit(); }
            }
            deleteModal.hide();
        });
        document.querySelectorAll('.js_btn_delete_with_warning').forEach(function (a) {
            a.addEventListener('click', function (e) {
                e.preventDefault();
                confirmBtn.dataset.formid = a.dataset.formid;
                document.getElementById('js_body_modal_confirm_delete').innerHTML =
                    '<strong>' + L.deleteFeedLine1 + '</strong><p>' + L.deleteFeedLine2 + '</p>';
                deleteModal.show();
            });
        });

        // ===== Custom XML modal =====
        const customXmlModalEl = document.getElementById('js_modal_custom_xml');
        const customXmlModal = bootstrap.Modal.getOrCreateInstance(customXmlModalEl);
        const genBtn = document.getElementById('js_btn_generate_custom_xml');
        document.querySelectorAll('.js_btn_configure_custom_xml').forEach(function (a) {
            a.addEventListener('click', function (e) {
                e.preventDefault();
                genBtn.dataset.feedid = a.dataset.feedid;
                customXmlModal.show();
            });
        });
        genBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const feedid = this.dataset.feedid;
            const numberOfDivisions = parseInt(document.getElementById('js_input_xml_divide_time').value, 10);
            if (!numberOfDivisions) { return; }
            const baseLink = document.querySelector('.js_download_xml_feed[data-feedid="' + feedid + '"]');
            if (!baseLink) { return; }
            const baseUrl = baseLink.getAttribute('href');
            const limit = Math.ceil(PSE_COUNT / numberOfDivisions);
            let html = '<ul class="mb-0">';
            for (let i = 0; i < numberOfDivisions; i++) {
                const offset = i * limit;
                if (offset + 1 > PSE_COUNT) { break; }
                let end = offset + limit;
                if (end > PSE_COUNT) { end = PSE_COUNT; }
                const url = baseUrl + '?offset=' + offset + '&limit=' + limit;
                html += '<li><a href="' + url + '" download>Xml file part ' + (i + 1) + ' : items ' + (offset + 1) + ' to ' + end + '</a></li>';
            }
            html += '</ul>';
            document.getElementById('js_xml_divided_link_container').innerHTML = html;
        });

        // ===== Taxonomy search =====
        const searchInput = document.getElementById('search-taxonomy');
        let searchTimer = null;
        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                const search = this.value;
                if (searchTimer !== null) { clearTimeout(searchTimer); }
                if (search.length > 2) {
                    searchTimer = setTimeout(function () {
                        fetch(TAXONOMY_URL).then(function (r) { return r.json(); }).then(function (data) {
                            let res = '';
                            const searchUp = search.toUpperCase();
                            Object.keys(data.cats || {}).forEach(function (k) {
                                const full = data.cats[k];
                                const name = full.split(' &gt; ').pop();
                                if (name.toUpperCase().indexOf(searchUp) !== -1) {
                                    res += '<option value="' + k + '">' + name + '</option>';
                                }
                            });
                            document.getElementById('google-taxonomy').innerHTML = res;
                        });
                    }, 350);
                }
            });
        }

        // ===== Advanced association-type toggle =====
        function refreshAssociationType(select) {
            const id = select.dataset.googlefieldid;
            const type = select.value;
            document.querySelectorAll('.js_field_related_to_association_type[data-googlefieldid="' + id + '"]').forEach(function (el) {
                el.style.display = 'none';
            });
            const target = document.querySelector('.js_field_related_to_association_type[data-googlefieldid="' + id + '"][data-associationtype="' + type + '"]');
            if (target) { target.style.display = ''; }
        }
        document.querySelectorAll('.js_advanced_select_association_type').forEach(function (select) {
            refreshAssociationType(select);
            select.addEventListener('change', function () { refreshAssociationType(this); });
        });

        // ===== Error log tab =====
        let errorLogResult = null;
        let logCurrentPage = 1;

        function getXmlLogAjax() {
            const limit = parseInt(document.getElementById('js_select_log_limit').value, 10);
            let offset = 0;
            if (errorLogResult !== null) { offset = (logCurrentPage - 1) * limit; }
            const params = new URLSearchParams();
            params.set('limit', limit);
            params.set('offset', offset);
            document.querySelectorAll('.js_checkbox_level_log:checked').forEach(function (cb) {
                params.set(LEVELS[cb.dataset.level].name, 1);
            });
            fetch(LOG_URL + '?' + params.toString())
                .then(function (r) { return r.json(); })
                .then(function (data) { errorLogResult = data; updateLogTable(); })
                .catch(function () {
                    document.getElementById('js_table_xml_log').innerHTML =
                        '<tr><td colspan="5">' + L.ajaxError + '</td></tr>';
                });
        }

        function escapeHtml(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function updateLogTable() {
            const nextBtns = document.querySelectorAll('.js_log_next_page');
            if (errorLogResult !== null && errorLogResult.length) {
                nextBtns.forEach(function (b) { b.classList.remove('disabled'); });
            } else {
                nextBtns.forEach(function (b) { b.classList.add('disabled'); });
            }
            document.querySelectorAll('.js_log_first_page, .js_log_previous_page').forEach(function (b) {
                if (logCurrentPage > 1) { b.classList.remove('disabled'); } else { b.classList.add('disabled'); }
            });
            if (errorLogResult === null) { return; }

            let html = '<tr><th>' + L.date + '</th><th>' + L.feed + '</th><th>' + L.level + '</th><th>' + L.message + '</th><th>' + L.productItem + '</th></tr>';
            if (errorLogResult.length > 0) {
                errorLogResult.forEach(function (log) {
                    const lvl = LEVELS[log.level] || LEVELS[1];
                    html += '<tr class="' + lvl.className + '">';
                    html += '<td>' + escapeHtml(log.date) + '</td>';
                    html += '<td>' + escapeHtml(log.feed_label) + '</td>';
                    html += '<td>' + lvl.label + '</td>';
                    let msg = escapeHtml(log.message);
                    if (log.help) {
                        msg += ' <a href="#" title="' + escapeHtml(log.help) + '"><i class="bi bi-question-circle"></i></a>';
                    }
                    html += '<td>' + msg + '</td>';
                    if (log.product_id) {
                        html += '<td><a href="' + PRODUCT_UPDATE_URL + '?product_id=' + encodeURIComponent(log.product_id) + '">' + escapeHtml(log.product_ref) + '</a></td>';
                    } else {
                        html += '<td>-</td>';
                    }
                    html += '</tr>';
                });
            } else {
                html += '<tr><td colspan="5">' + L.nothing + '</td></tr>';
            }
            document.getElementById('js_table_xml_log').innerHTML = html;
        }

        document.querySelectorAll('.js_btn_gsxml_log_refresh, .js_tab_gsxml_log, .js_log_first_page').forEach(function (el) {
            el.addEventListener('click', function (e) { e.preventDefault(); logCurrentPage = 1; getXmlLogAjax(); });
        });
        document.getElementById('js_select_log_limit').addEventListener('change', function () { logCurrentPage = 1; getXmlLogAjax(); });
        document.querySelectorAll('.js_checkbox_level_log').forEach(function (cb) {
            cb.addEventListener('change', function () { logCurrentPage = 1; getXmlLogAjax(); });
        });
        document.querySelectorAll('.js_log_previous_page').forEach(function (el) {
            el.addEventListener('click', function (e) { e.preventDefault(); if (logCurrentPage > 1) { logCurrentPage--; getXmlLogAjax(); } });
        });
        document.querySelectorAll('.js_log_next_page').forEach(function (el) {
            el.addEventListener('click', function (e) { e.preventDefault(); if (errorLogResult !== null && errorLogResult.length > 0) { logCurrentPage++; getXmlLogAjax(); } });
        });
    });
})();
</script>
